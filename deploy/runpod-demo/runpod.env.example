# Public settings, NOT a copy of the local .env.
PORT=8000
PORT_HEALTH=8081
HEALTH_CHECK_PATH=/ping
QA_DATA_DIR=/runpod-volume
DEFAULT_MODEL_KEY=llama3.2-finetuned
DEMO_MODELS=llama3.2-base,llama3.2-finetuned,gemma2-base,gemma2-finetuned
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
MAX_QUEUE=2
QUEUE_WAIT_TIMEOUT=60
OLLAMA_TIMEOUT=120
QA_STARTUP_TIMEOUT=1200
# Optional: HF_TOKEN as a Runpod secret for private/gated retrieval models.
# NEVER expose Ollama port 11434. Evaluation API is disabled by the adapter.
