# Backend only. Do not commit .env or expose its values through the frontend.
HF_Faiss=
INFERENCE_URL=http://127.0.0.1:11434
KB_CACHE_DIR=app/kb_cache
# Empty = same-origin web. For separate frontend, set the exact HTTPS origin.
ALLOWED_ORIGINS=
DEFAULT_MODEL_KEY=llama3.2-finetuned
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=8192
# Prompt batch size bounds peak model memory; context length remains unchanged.
OLLAMA_NUM_BATCH=128
# -1: Ollama chooses GPU placement. 0: force CPU if this host cannot allocate GPU memory.
OLLAMA_NUM_GPU=-1
OLLAMA_TIMEOUT=120
MAX_NEW_TOKENS=384
QUEUE_CONCURRENCY=1
MAX_QUEUE=4
QUEUE_WAIT_TIMEOUT=180
CACHE_TTL=600
RERANK_SCORE_THRESHOLD=-1.0
# Empty: GPU <=6 GiB reserves VRAM for Ollama; retrieval uses CPU. Larger GPUs use library auto-selection.
# Explicit cpu/cuda overrides this policy; benchmark memory and latency together.
EMBEDDING_DEVICE=
RERANKER_DEVICE=
# Set commit revisions before preparing a frozen KB/model release.
KB_REVISION=
EMBEDDING_REVISION=
RERANKER_REVISION=
# Private research API; never enable on the public reverse-proxy route.
ENABLE_EVALUATION_API=false
EVALUATION_API_KEY=
